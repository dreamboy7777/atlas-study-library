# Leave DATABASE_URL empty to use local PGlite (.data/pg) — no setup needed.
# Set it to a Neon / Supabase / local Postgres connection string to use a real server.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Admin console passcode. Change before deploying anywhere public.
ADMIN_PASSCODE="kellyisthecutest"
# Extra salt for the admin cookie; change it and existing sessions are invalidated.
ADMIN_SECRET="change-me"
